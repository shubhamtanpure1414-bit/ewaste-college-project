# ── MySQL (Railway provides these automatically when you attach a MySQL plugin) ──
MYSQLHOST=localhost
MYSQLUSER=root
MYSQLPASSWORD=your_mysql_password
MYSQLPORT=3306
MYSQLDATABASE=ewaste_college_db

# ── Flask ────────────────────────────────────────────────────────────────────────
